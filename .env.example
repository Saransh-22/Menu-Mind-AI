# MenuMind AI Environment Configuration
# Copy this file to .env and fill in your credentials

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Search API Key (for web review retrieval)
# Supports SerpApi (https://serpapi.com) or Google Custom Search API
SEARCH_API_KEY=your_search_api_key_here
SEARCH_ENGINE_ID=your_custom_search_engine_id_here

# Database path (default: ./menumind.db)
DATABASE_PATH=./menumind.db

# Optional: Maximum tool calls per agent run (default: 20)
AGENT_MAX_TOOL_CALLS=20

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

