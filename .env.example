# ==============================================================================
# MENUMIND AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' at the root of the project:
#   copy .env.example .env
#
# Replace placeholders with your actual API credentials.
# NEVER commit your actual '.env' file containing real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE LLM & MULTI-AGENT ORCHESTRATION (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Required for full Agentic AI functionality, multi-specialist chat, vision
# extraction, and intelligent menu recommendations.
#
# How to obtain:
#   1. Visit Google AI Studio: https://aistudio.google.com/
#   2. Sign in with your Google Account
#   3. Click "Create API Key" and select an existing Google Cloud project
#   4. Paste your key below.
#
# Free Tier:
#   Gemini 1.5/2.0 Flash offers free tier limits (up to 15 RPM / 1M TPM).
# Fallback:
#   If left blank, MenuMind AI will gracefully degrade to deterministic rule-based
#   heuristics, enabling testing and evaluation without an API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Primary reasoning & agent model (Default: gemini-2.0-flash or gemini-2.8-flash)
GEMINI_MODEL=gemini-2.0-flash

# Chat specialist model used by the multi-agent conversational orchestrator
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Vision model for extracting menu items, prices, and categories from photos/PDFs
GEMINI_VISION_MODEL=gemini-2.0-flash

# Maximum tool-calling depth for the multi-agent loop
AGENT_MAX_TOOL_CALLS=20


# ------------------------------------------------------------------------------
# 2. EXTERNAL REVIEW RETRIEVAL (SERPAPI OR GOOGLE CUSTOM SEARCH)
# ------------------------------------------------------------------------------
# Optional: Used to automatically enrich restaurant datasets with live web reviews
# when uploaded dataset reviews are below the threshold (< 5 reviews).
#
# Option A — SerpApi (Recommended for simplicity):
#   1. Sign up at https://serpapi.com/
#   2. Copy your private API key from your dashboard (100 free searches/month)
#   3. Paste below into SEARCH_API_KEY. Leave SEARCH_ENGINE_ID blank.
#
# Option B — Google Custom Search Engine (CSE):
#   1. Create an API key in Google Cloud Console with "Custom Search API" enabled.
#   2. Configure a Programmable Search Engine at https://programmablesearchengine.google.com/
#   3. Put your API Key in SEARCH_API_KEY and your Engine ID in SEARCH_ENGINE_ID.
#
# Fallback:
#   If left blank, MenuMind AI uses realistic domain-tailored synthetic reviews.
SEARCH_API_KEY=your_search_api_key_here
SEARCH_ENGINE_ID=your_custom_search_engine_id_here


# ------------------------------------------------------------------------------
# 3. VISUAL MENU DESIGN STUDIO & IMAGE GENERATION
# ------------------------------------------------------------------------------
# Provider options:
#   - auto: Attempts Google Imagen if credentials available; falls back cleanly to
#           publication-grade thematic SVG artwork generator.
#   - google_imagen: Uses Google Imagen (via GEMINI_API_KEY or IMAGE_GENERATION_API_KEY).
#   - thematic_svg: High-fidelity, zero-distortion vector design rendering (no external API needed).
IMAGE_GENERATION_PROVIDER=auto

# Optional: Only needed if using a separate API key for image generation.
# If omitted, GEMINI_API_KEY is automatically utilized.
IMAGE_GENERATION_API_KEY=

# Imagen Model identifier
IMAGE_GENERATION_MODEL=imagen-3.0-generate-002


# ------------------------------------------------------------------------------
# 4. PERSISTENCE & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite database path. Default is './menumind.db' in the project root.
DATABASE_PATH=./menumind.db


# ------------------------------------------------------------------------------
# 5. SERVER, NETWORKING & FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of additional allowed CORS origins (Vite defaults included)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Backend logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Frontend API base URL (used during Vite production builds or external hosts)
# When developing locally with Vite proxy, leave empty or set to http://localhost:8000
VITE_API_BASE_URL=
